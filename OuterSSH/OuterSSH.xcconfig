PRODUCT_NAME = OuterSSH
SKIP_INSTALL = YES
STRIP_INSTALLED_PRODUCT = NO
SUPPORTED_PLATFORMS = macosx iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
MACOSX_DEPLOYMENT_TARGET = 14.6
IPHONEOS_DEPLOYMENT_TARGET = 17.0
GCC_C_LANGUAGE_STANDARD = gnu17
ENABLE_USER_SCRIPT_SANDBOXING = NO
CLANG_ENABLE_MODULES = NO
SWIFT_VERSION = 6.0
PRODUCT_MODULE_NAME = OuterSSHAppleCrypto
SWIFT_OBJC_INTEROP_MODE = objc
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated
VENDOR_BUILD_ROOT = $(CONFIGURATION_TEMP_DIR)/OuterSSHVendor
OUTERSSH_VENDOR_SUFFIX = $(PLATFORM_NAME)-$(CURRENT_ARCH)
OUTERSSH_VENDOR_SUFFIX[sdk=macosx*] = $(CURRENT_ARCH)
HEADER_SEARCH_PATHS = $(inherited) "$(SRCROOT)/OuterSSH/include/OuterSSH" "$(SRCROOT)/OuterSSH/olibssh/libssh2" $(OUTERSSH_HEADERS_$(OUTERSSH_CRYPTO_BACKEND))
OTHER_LIBTOOLFLAGS = $(inherited) -no_warning_for_no_symbols $(OUTERSSH_LIBRARIES_$(OUTERSSH_CRYPTO_BACKEND))
OUTERSSH_CRYPTO_BACKEND = apple
OUTERSSH_HEADERS_openssl = "$(BUILT_PRODUCTS_DIR)/openssl-$(OUTERSSH_VENDOR_SUFFIX)/include"
OUTERSSH_LIBRARIES_openssl = "$(BUILT_PRODUCTS_DIR)/openssl-$(OUTERSSH_VENDOR_SUFFIX)/lib/libcrypto.a"
OUTERSSH_EXCLUDED_openssl = AppleCrypto.swift apple.c
OUTERSSH_EXCLUDED_apple = openssl.c cipher-chachapoly.c bcrypt_pbkdf.c pem.c
OUTERSSH_DEFINES_apple = OUTERSSH_APPLE_CRYPTO=1
OUTERSSH_SWIFT_apple = OUTERSSH_APPLE_CRYPTO
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) $(OUTERSSH_DEFINES_$(OUTERSSH_CRYPTO_BACKEND))
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(OUTERSSH_SWIFT_$(OUTERSSH_CRYPTO_BACKEND))
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) blowfish.c *.java *.js $(OUTERSSH_EXCLUDED_$(OUTERSSH_CRYPTO_BACKEND))
